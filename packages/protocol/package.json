{
	"name": "@omp-deck/protocol",
	"version": "0.6.1",
	"private": false,
	"description": "Wire types and JSON schemas shared by omp-deck's server, web UI and bridges. Ships TypeScript source: it is consumed by Bun (and by the deck's bundled copy).",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/bjb2/omp-deck.git",
		"directory": "packages/protocol"
	},
	"author": "Bryan Bartley",
	"homepage": "https://github.com/bjb2/omp-deck#readme",
	"bugs": {
		"url": "https://github.com/bjb2/omp-deck/issues"
	},
	"engines": {
		"bun": ">=1.3.14"
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"src",
		"!src/**/*.test.ts"
	],
	"type": "module",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": "./src/index.ts"
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"test": "bun test"
	},
	"dependencies": {
		"ajv": "^8.17.1",
		"ajv-formats": "^3.0.1"
	},
	"devDependencies": {
		"@types/bun": "^1.3.14",
		"typescript": "^5.6.3"
	}
}
